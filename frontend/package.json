{
  "name": "gst-reconciler",
  "version": "1.0.0",
  "description": "GST Reconciler Desktop App for Chartered Accountants",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  },
  "build": {
